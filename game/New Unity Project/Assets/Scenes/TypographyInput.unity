  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Ki\u1EC3m tra IME th\u1EE7 c\xF4ng (Windows):</b>\n1. Th\xEAm b\xE0n ph\xEDm Microsoft IME ti\u1EBFng Nh\u1EADt, b\u1EA5m v\xE0o \xF4 nh\u1EADp.\n2. Alt+` ho\u1EB7c ph\xEDm \u534A\u89D2/\u5168\u89D2 \u0111\u1EC3 b\u1EADt ch\u1EBF \u0111\u1ED9 \u3042.\n3. G\xF5 <i>ringo</i> \u2192 th\u1EA5y \u308A\u3093\u3054 \u1EDF d\xF2ng \u201CIME \u0111ang so\u1EA1n\u201D, \xF4 \u201C\u0110\xE3 x\xE1c nh\u1EADn\u201D ch\u01B0a \u0111\u1ED5i.\n4. Space \u0111\u1EC3 \u0111\u1ED5i sang \u30EA\u30F3\u30B4 / \u6797\u6A8E; trong l\xFAc so\u1EA1n b\u1EA5m Tab v\xE0 Esc \u2192 log ghi \u201CIME \u0111ang so\u1EA1n\u201D, kh\xF4ng \u0111\u1ED5i m\u1EE5c ti\xEAu, kh\xF4ng tho\xE1t.\n5. Enter \u0111\u1EC3 ch\u1ED1t \u2192 ch\u1EEF chuy\u1EC3n sang \u201C\u0110\xE3 x\xE1c nh\u1EADn\u201D. Enter l\u1EA7n n\u1EEFa \u2192 log \u201Cx\xE1c nh\u1EADn\u201D.\n6. Th\u1EED th\xEAm: shingouki \u2192 \u4FE1\u53F7\u6A5F, taberu \u2192 \u98DF\u3079\u308B, painappuru \u2192 \u30D1\u30A4\u30CA\u30C3\u30D7\u30EB."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d0b9847c123ffe445a1e6e3c1bd7704f, type: 2}
